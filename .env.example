# Copy to .env.local (web) or export before db commands. Never commit secrets.

# Neon pooled connection string (Vercel Marketplace). postgres:// also accepted.
DATABASE_URL=postgresql://user:pass@localhost:5432/meownow

# Public origin of the Next.js app.
APP_URL=http://localhost:3000

# HMAC for WebAuthn challenge cookies. At least 32 characters.
SESSION_SECRET=dev-session-secret-must-be-32b!

# Gates invite-less first passkey enroll for the seeded admin. At least 16 characters.
ADMIN_ENROLL_SECRET=dev-admin-enroll

# Seeded admin (no passkey until /enroll).
SEED_ADMIN_HANDLE=rishi
SEED_ADMIN_DISPLAY_NAME=Rishi

# Optional until later milestones.
# SENTRY_DSN=
# VAPID_PUBLIC_KEY=
# CAPABILITY_TOKEN_PUBLIC_KEY=

# Shared HMAC for Worker WebSocket tickets and fan-out. At least 32 characters.
# HUB_SECRET=dev-hub-secret-must-be-32-bytes!!
# Public Worker origin used by Vercel to POST /fanout.
# EDGE_URL=http://localhost:8787

# Copy to .env.local (web) or export before db commands. Never commit secrets.

# Neon pooled connection string (Vercel Marketplace). postgres:// also accepted.
DATABASE_URL=postgresql://user:pass@localhost:5432/meownow

# Public origin of the Next.js app.
APP_URL=http://localhost:3000

# Seeded admin (no passkey until milestone 2).
SEED_ADMIN_HANDLE=rishi
SEED_ADMIN_DISPLAY_NAME=Rishi


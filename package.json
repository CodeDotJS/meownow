{
	"name": "meownow",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"lint": "biome check .",
		"test": "turbo test",
		"db:generate": "pnpm --filter @meownow/db generate",
		"db:migrate": "pnpm --filter @meownow/db migrate",
		"db:seed": "pnpm --filter @meownow/db seed"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"turbo": "2.10.11",
		"typescript": "5.9.3"
	}
}

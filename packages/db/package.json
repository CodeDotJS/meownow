{
	"name": "@meownow/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"generate": "drizzle-kit generate",
		"check": "drizzle-kit check",
		"migrate": "tsx --env-file=../../.env src/migrate.ts",
		"seed": "tsx --env-file=../../.env src/seed.ts"
	},
	"dependencies": {
		"@meownow/config": "workspace:*",
		"@neondatabase/serverless": "1.1.0",
		"drizzle-orm": "0.45.2",
		"ws": "8.21.3"
	},
	"devDependencies": {
		"@types/node": "22.19.21",
		"@types/ws": "8.18.1",
		"drizzle-kit": "0.31.10",
		"tsx": "4.23.12",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}

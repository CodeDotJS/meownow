{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"lint": {},
		"test": {
			"dependsOn": []
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
